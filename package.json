{
  "name": "task-app",
  "version": "1.0.0",
  "description": "三層構成のタスク管理アプリ (フロント: TypeScript / バックエンド: Express / DB: PostgreSQL)",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p frontend/tsconfig.json",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
